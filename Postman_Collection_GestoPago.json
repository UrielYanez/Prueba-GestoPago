              "script": {
                "exec": [
                  "pm.test('Status code es 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.test('Retorna challengeToken y secreto para Google Authenticator', function () {",
                  "    pm.expect(json.datos.requiere2fa).to.be.true;",
                  "    pm.expect(json.datos.challengeToken).to.not.be.empty;",
                  "    pm.expect(json.datos.secretManual).to.not.be.empty;",
                  "});",
                  "if (json.datos) {",
                  "    pm.collectionVariables.set('challenge_token', json.datos.challengeToken);",
                  "    pm.collectionVariables.set('totp_secret', json.datos.secretManual);",
                  "    console.log('Challenge Token guardado. Secreto TOTP Base32:', json.datos.secretManual);",
                  "    console.log('URI para QR Google Authenticator:', json.datos.otpAuthUri);",
                  "}"
