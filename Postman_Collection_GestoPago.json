  "item": [
    {
      "name": "01. Autenticación y Registro",
      "item": [
        {
          "name": "01. Registro Cliente (Onboarding) - Exitoso [201]",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Generar identificadores únicos para cada corrida cumpliendo los regex del backend",
                  "const timestamp = new Date().getTime().toString().slice(-4);",
                  "const dosDigitos = timestamp.slice(-2);",
                  "const unDigito = timestamp.slice(-1);",
                  "",
                  "// CURP: 4 letras + 6 digitos + H + 5 letras + 1 digito + 1 digito",
                  "const randomCurp = 'AGRA950515HDFRYR' + dosDigitos;",
                  "",
                  "// RFC: 4 letras + 6 digitos + [A-V1-9] + [A-Z1-9] + [0-9A]",
                  "const randomRfc = 'AGRA950515HA' + unDigito;",
                  "const randomEmail = 'usuario_' + timestamp + '@prueba.com';",
                  "",
                  "pm.collectionVariables.set('temp_correo', randomEmail);",
                  "pm.collectionVariables.set('temp_curp', randomCurp);",
                  "pm.collectionVariables.set('temp_rfc', randomRfc);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code es 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "pm.test('Respuesta cumple estructura uniforme ApiResponse', function () {",
                  "    pm.expect(json.exito).to.be.true;",
                  "    pm.expect(json.codigoEstado).to.eql(201);",
                  "    pm.expect(json.datos).to.not.be.null;",
                  "});",
                  "",
                  "if (json.datos && json.datos.id) {",
                  "    pm.collectionVariables.set('cliente_id', json.datos.id);",
                  "    console.log('Cliente ID guardado:', json.datos.id);",
                  "}",
                  "",
                  "if (json.datos && json.datos.cuentas && json.datos.cuentas.length > 0) {",
                  "    pm.collectionVariables.set('numero_cuenta', json.datos.cuentas[0].numeroCuenta);",
                  "    console.log('Número de cuenta guardado:', json.datos.cuentas[0].numeroCuenta);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Alejandro\",\n  \"segundoNombre\": \"Martín\",\n  \"apellidoPaterno\": \"Aguayo\",\n  \"apellidoMaterno\": \"Reyes\",\n  \"fechaNacimiento\": \"1995-05-15\",\n  \"curp\": \"{{temp_curp}}\",\n  \"rfc\": \"{{temp_rfc}}\",\n  \"sexo\": \"HOMBRE\",\n  \"nacionalidad\": \"MEXICANA\",\n  \"estadoCivil\": \"SOLTERO\",\n  \"correoElectronico\": \"{{temp_correo}}\",\n  \"password\": \"Password123!\",\n  \"telefonoMovil\": \"5512345678\",\n  \"telefonoAlternativo\": \"\",\n  \"calle\": \"Av. Universidad\",\n  \"numeroExterior\": \"1200\",\n  \"numeroInterior\": \"B-4\",\n  \"codigoPostal\": \"03100\",\n  \"colonia\": \"Del Valle\",\n  \"municipio\": \"Benito Juárez\",\n  \"estado\": \"Ciudad de México\",\n  \"pais\": \"MEXICO\",\n  \"ocupacion\": \"Ingeniero de Software\",\n  \"empresa\": \"Tech Solutions\",\n  \"ingresoMensual\": 45000.00\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/clientes",
              "host": ["{{base_url}}"],
              "path": ["clientes"]
            }
          }
