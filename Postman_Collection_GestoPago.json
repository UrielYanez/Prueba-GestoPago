        {
          "name": "02.1. Login Paso 2 (Verificar 2FA TOTP en MOVIL -> Emite JWT Definitivo) [200]",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Calcula automáticamente el código TOTP de 6 dígitos (RFC 6238) a partir de {{totp_secret}}",
                  "const CryptoJS = require('crypto-js');",
                  "const base32Secret = pm.collectionVariables.get('totp_secret') || '';",
                  "const alphabet = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ234567';",
                  "let bits = '';",
                  "const clean = base32Secret.replace(/=+$/, '').toUpperCase();",
                  "for (let i = 0; i < clean.length; i++) {",
                  "    const val = alphabet.indexOf(clean.charAt(i));",
                  "    if (val >= 0) bits += val.toString(2).padStart(5, '0');",
                  "}",
                  "const hexKey = [];",
                  "for (let i = 0; i + 8 <= bits.length; i += 8) {",
                  "    hexKey.push(parseInt(bits.substring(i, i + 8), 2).toString(16).padStart(2, '0'));",
                  "}",
                  "const keyWords = CryptoJS.enc.Hex.parse(hexKey.join(''));",
                  "const timeWindow = Math.floor(Date.now() / 1000 / 30);",
                  "const timeHex = timeWindow.toString(16).padStart(16, '0');",
                  "const timeWords = CryptoJS.enc.Hex.parse(timeHex);",
                  "const hmac = CryptoJS.HmacSHA1(timeWords, keyWords).toString(CryptoJS.enc.Hex);",
                  "const offset = parseInt(hmac.substring(hmac.length - 1), 16) * 2;",
                  "const binary = (parseInt(hmac.substring(offset, offset + 8), 16) & 0x7fffffff) % 1000000;",
                  "const otp = binary.toString().padStart(6, '0');",
                  "pm.collectionVariables.set('codigo_2fa', otp);",
                  "console.log('Código TOTP RFC 6238 calculado:', otp);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code es 200 OK y emite JWT con sesión activa en MOVIL', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.test('Retorna token JWT definitivo y datos de sesión', function () {",
                  "    pm.expect(json.datos.token).to.not.be.empty;",
                  "    pm.expect(json.datos.plataforma).to.eql('MOVIL');",
                  "    pm.expect(json.datos.sessionId).to.not.be.empty;",
                  "});",
                  "if (json.datos && json.datos.token) {",
                  "    pm.collectionVariables.set('jwt_token', json.datos.token);",
                  "    pm.collectionVariables.set('jwt_token_movil_anterior', json.datos.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
