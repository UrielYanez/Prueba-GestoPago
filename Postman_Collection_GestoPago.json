              "script": {
                "exec": [
                  "pm.test('Status code es 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "pm.test('Retorna token JWT', function () {",
                  "    pm.expect(json.datos.token).to.not.be.empty;",
                  "});",
                  "",
                  "if (json.datos && json.datos.token) {",
                  "    pm.collectionVariables.set('jwt_token', json.datos.token);",
                  "    console.log('JWT Token guardado para siguientes peticiones');",
                  "}"
