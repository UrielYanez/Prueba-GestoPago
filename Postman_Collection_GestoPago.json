      "name": "02. Manejo Centralizado de Errores (ExceptionHandler)",
      "item": [
        {
          "name": "04. Error - Validación Bean Validation (@Valid) [400]",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code es 400 Bad Request', function () {",
                  "    pm.response.to.have.status(400);",
